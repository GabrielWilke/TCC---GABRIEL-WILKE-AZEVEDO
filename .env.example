# Copie este arquivo para .env e preencha os valores.

# Painel (server.js)
PORT=3000

# API GPP - URLs base por ambiente
API_BASE_URL_HOMOL=https://api-gpp-homol.beontag.com
API_BASE_URL_PROD=https://api-gpp.beontag.com

# API GPP - Endpoints
ENDPOINT_LOGIN=/v2/login
ENDPOINT_LABEL=/v2/label
ENDPOINT_PRINTER=/v2/printer
ENDPOINT_PRINTER_LIST_BY_LABEL=/v2/printer/list-by-label
ENDPOINT_PRODUCT=/v2/product
ENDPOINT_PRODUCT_LIST_BY_FIELD=/v2/product/list-by-field
ENDPOINT_READER=/v2/reader
ENDPOINT_SITE=/v2/site
ENDPOINT_USER=/v2/user

# Credenciais
API_USERNAME=
API_PASSWORD=

# Massa de dados (homologação)
TENANT_GUID=
SITE_GUID=
LABEL_GUID=
